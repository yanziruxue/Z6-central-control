<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.l6.carmedia"
    android:versionCode="3"
    android:versionName="1.2.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- 保存壁纸到 Download/L6/壁纸（API 29 及以下走传统存储） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 枚举车机已装音乐/导航 App（API 30+ 包可见性） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- OTA 升级安装新版本需要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 悬浮窗权限：已不作为返回主页主通道（改用系统默认桌面）；仅保留作备用通道的授权入口 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- OTA 调起系统安装器（API 30+ 包可见性需要） -->
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.l6.carmedia.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 设为默认桌面：用户在系统「默认应用 → 主屏幕应用」里选本应用后，
                 按 HOME 键 / 上滑回桌面都会回到本界面（导航 App 全屏后也能正常返回）。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- OTA 安装用的 ContentProvider（不依赖 support / androidx） -->
        <provider
            android:name="com.l6.carmedia.OtaFileProvider"
            android:authorities="com.l6.carmedia.otafp"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          通知监听：音乐（媒体会话）+ 导航（导航 App 的常驻通知）真实数据的来源。
          需要用户在「设置 → 通知使用权」里手动授权，未授权时页面自动回落演示数据。
          android:label 必须显式给出，否则部分车机会在授权列表里显示空白项。
        -->
        <service
            android:name="com.l6.carmedia.L6NotifyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
