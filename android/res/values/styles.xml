<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全屏无标题栏深色主题：车机横屏常驻，不要系统 ActionBar/状态栏 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#FF0B0E14</item>
        <item name="android:colorBackground">#FF0B0E14</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
