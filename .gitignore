# 签名配置含口令，绝不入库
android/keystore.properties

# Gitea 访问令牌（发版到 git.ziruxue.top 用），等同 keystore.properties 保密
android/gitea_token.properties

# 交互式输入的凭证（发版/补发脚本从 push.env 读 GIT_ZX_TOKEN）
# ★ 发版脚本会 git add -A ⇒ 这几条必须有，否则 token 会被直接提交进历史
push.env
.env
*.env

# 构建中间产物（build.sh 用带时间戳的 C:/Users/yanzi/l6apk-build-<ts>，这里只是兜底）
android/build/
android/out/

# 打包产物：只作为 GitHub Release 资产上传，不进 git
dist/

# WorkBuddy 会话数据 / 本地工具缓存（体积大且与源码无关）
.workbuddy/
._cache_adb.exe
*.exe

# Python / 编辑器
__pycache__/
*.pyc
.vscode/
.idea/

# 临时交接文档（不进 git 历史，按需手动 git add -f）
开发进度与交接说明.md
