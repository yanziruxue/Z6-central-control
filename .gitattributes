# 换行符规范化：避免 Windows 的 core.autocrlf 把 CRLF 带进 shell 脚本
# （CRLF 的 .sh 在 Linux/Cygwin 下会报 `\r: command not found`）
* text=auto eol=lf

*.sh    text eol=lf
*.js    text eol=lf
*.java  text eol=lf
*.py    text eol=lf
*.xml   text eol=lf
*.properties text eol=lf
*.md    text eol=lf

# 二进制资产不做转换
*.png   binary
*.apk   binary
*.jks   binary
